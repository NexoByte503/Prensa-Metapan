# URL pública del sitio. En producción, usa el dominio definitivo.
# Ejemplo: https://tudominio.com
VITE_SITE_URL=http://localhost:5173
# URL absoluta de una imagen social pública real (opcional, 1200×630 recomendado).
VITE_SOCIAL_IMAGE=

# Permite indexar el portal en buscadores. Mantener en false hasta el lanzamiento.
VITE_SITE_INDEXABLE=false
VITE_GOOGLE_SITE_VERIFICATION=

# Supabase: valores públicos del proyecto.
# El portal público funciona sin estas variables; /admin requiere ambas.
#
# 1. Copia Project URL y la clave publicable (o anon key) del proyecto.
# 2. En Supabase Auth, desactiva el registro público.
# 3. Agrega https://TU-DOMINIO/admin/restablecer-contrasena a las Redirect URLs.
# 4. Nunca coloques la secret key ni la service_role key en variables VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
